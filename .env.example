# ============================================================
# AUTOMATIC PLATFORM — Variables d'environnement
# Copiez ce fichier vers .env (ou .env.local) et renseignez les valeurs.
# ⚠️ Ne committez JAMAIS le fichier .env : il est ignoré par git.
# ============================================================

# --- Base de données (PostgreSQL — Neon / Vercel Postgres) --
# DATABASE_URL : URL POOLÉE (hôte avec suffixe -pooler) pour le trafic
# applicatif. Neon utilise PgBouncer en mode transaction — idéal serverless.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# DATABASE_URL_UNPOOLED : URL DIRECTE (sans -pooler) — réservations de
# session (SET, LISTEN/NOTIFY), dumps, réplication.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL : utilisée par prisma.config.ts pour les migrations
# (prisma db push / migrate). = même valeur que DATABASE_URL_UNPOOLED.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Authentification (Neon Auth — Better Auth managé) ------
# Injectées par `neon deploy` / `neon env pull` (voir neon.ts).
# NEON_AUTH_BASE_URL : URL du service d'auth de la branche.
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth"
# Secret de signature des cookies de session (32+ caractères).
# Générer : openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""
# Optionnel (JWT / vérification de tokens) :
NEON_AUTH_JWKS_URL="https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# --- Supabase (Realtime & Storage uniquement) ---------------
# L'authentification ne dépend plus de Supabase. Ces clés servent
# uniquement aux canaux temps réel (chat, notifications) et au
# stockage de fichiers (bucket project-assets).
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- Email transactionnel (Resend) --------------------------
RESEND_API_KEY="re_..."

# --- Passerelle de paiement Moneroo (https://moneroo.io) ----
# Clé API secrète (Dashboard Moneroo → Développeurs → Clés API).
# Mode test : clé de la boutique de test (pck_test_...).
# Mode production : clé secrète de production (pck_live_...).
MONEROO_SECRET_KEY=""

# Secret du webhook Moneroo (Dashboard → Développeurs → Webhooks).
# Sert à vérifier la signature HMAC-SHA256 des requêtes webhook.
MONEROO_WEBHOOK_SECRET=""

# URL publique de l'application (sans slash final).
# Utilisée pour construire l'URL de retour après paiement.
# Exemple production : https://automatic.votre-domaine.com
NEXT_PUBLIC_APP_URL=""

# Devise des paiements (défaut : XOF).
# ⚠️ En mode test, seules les devises activées dans le dashboard Moneroo
# fonctionnent (ex. USD en sandbox). Repassez à XOF en production.
MONEROO_CURRENCY="XOF"
