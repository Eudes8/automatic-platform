# ============================================================
# AUTOMATIC PLATFORM — Variables d'environnement
# Copiez ce fichier vers .env (ou .env.local) et renseignez les valeurs.
# ⚠️ Ne committez JAMAIS le fichier .env : il est ignoré par git.
# ============================================================

# --- Base de données (PostgreSQL) ---------------------------
DATABASE_URL="postgresql://user:password@host:5432/automatic_platform"

# --- Supabase (Auth & Storage) ------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- Email transactionnel (Resend) --------------------------
RESEND_API_KEY="re_..."

# --- Passerelle de paiement Moneroo (https://moneroo.io) ----
# Clé API secrète (Dashboard Moneroo → Développeurs → Clés API).
# Mode test : clé de la boutique de test (pck_test_...).
# Mode production : clé secrète de production (pck_live_...).
MONEROO_SECRET_KEY=""

# Secret du webhook Moneroo (Dashboard → Développeurs → Webhooks).
# Sert à vérifier la signature HMAC-SHA256 des requêtes webhook.
MONEROO_WEBHOOK_SECRET=""

# URL publique de l'application (sans slash final).
# Utilisée pour construire l'URL de retour après paiement.
# Exemple production : https://automatic.votre-domaine.com
NEXT_PUBLIC_APP_URL=""

# Devise des paiements (défaut : XOF).
# ⚠️ En mode test, seules les devises activées dans le dashboard Moneroo
# fonctionnent (ex. USD en sandbox). Repassez à XOF en production.
MONEROO_CURRENCY="XOF"
