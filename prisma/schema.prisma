generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  createdAt       DateTime         @default(now())
  role            UserRole         @default(CLIENT)
  avatarUrl       String?
  companyName     String?
  industry        String?
  phone           String?
  updatedAt       DateTime         @default(now()) @updatedAt
  adminActions    AuditLog[]       @relation("AdminActions")
  invoices        Invoice[]
  messages        Message[]
  notifications   Notification[]
  projects        Project[]
  assignedTickets Ticket[]         @relation("AssignedTickets")
  clientTickets   Ticket[]         @relation("ClientTickets")
  ticketResponses TicketResponse[]
  conversations   Conversation[]   @relation("ConversationUsers")
  memberships     ProjectMember[]
  assignedTasks   Task[]           @relation("TaskAssignee")
  createdTasks    Task[]           @relation("TaskCreator")

  @@index([email])
}

model Project {
  id             String          @id @default(cuid())
  title          String
  description    String?
  budget         Float?
  progress       Int             @default(0)
  clientId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  contractSigned Boolean         @default(false)
  contractUrl    String?
  status         ProjectStatus   @default(ONBOARDING)
  category       String?
  techStack      String[]
  timeline       String?
  assets         Asset[]
  contracts      Contract[]
  conversations  Conversation[]
  invoices       Invoice[]
  messages       Message[]
  client         User            @relation(fields: [clientId], references: [id])
  requirements   Requirement[]
  tickets        Ticket[]
  members        ProjectMember[]
  tasks          Task[]
  milestones     Milestone[]
  deliverables   Deliverable[]

  @@index([clientId])
  @@index([status])
  @@index([category])
}

model Requirement {
  id            String                     @id @default(cuid())
  projectId     String
  title         String
  description   String
  status        RequirementStatus          @default(SUGGESTED)
  createdBy     String
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  category      RequirementCategory        @default(OTHER)
  project       Project                    @relation(fields: [projectId], references: [id])
  comments      RequirementComment[]
  statusHistory RequirementStatusHistory[]

  @@index([projectId])
}

model RequirementComment {
  id            String      @id @default(cuid())
  requirementId String
  authorId      String
  text          String
  createdAt     DateTime    @default(now())
  attachments   String[]
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  @@index([requirementId])
}

model RequirementStatusHistory {
  id            String             @id @default(cuid())
  requirementId String
  from          RequirementStatus?
  to            RequirementStatus
  changedBy     String
  createdAt     DateTime           @default(now())
  requirement   Requirement        @relation(fields: [requirementId], references: [id])

  @@index([requirementId])
}

model Contract {
  id              String         @id @default(cuid())
  projectId       String
  content         String
  signatureBase64 String?
  signedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  status          ContractStatus @default(DRAFT)
  project         Project        @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model Conversation {
  id        String    @id @default(cuid())
  subject   String?
  projectId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project?  @relation(fields: [projectId], references: [id])
  messages  Message[]
  users     User[]    @relation("ConversationUsers")

  @@index([projectId])
}

model Message {
  id             String        @id @default(cuid())
  projectId      String?
  senderId       String
  text           String
  attachment     String?
  createdAt      DateTime      @default(now())
  conversationId String?
  read           Boolean       @default(false)
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  project        Project?      @relation(fields: [projectId], references: [id])
  sender         User          @relation(fields: [senderId], references: [id])

  @@index([projectId])
  @@index([senderId])
  @@index([conversationId])
}

model Asset {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model Invoice {
  id          String        @id @default(cuid())
  projectId   String?
  clientId    String
  amount      Float
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime
  pdfUrl      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  description String?
  amountPaid  Float         @default(0)
  receiptUrl  String?
  client      User          @relation(fields: [clientId], references: [id])
  project     Project?      @relation(fields: [projectId], references: [id])
  payments    Payment[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model Payment {
  id            String          @id @default(cuid())
  invoiceId     String
  provider      PaymentProvider @default(MONEROO)
  providerRef   String          @unique
  amount        Float
  currency      String          @default("XOF")
  status        PaymentStatus   @default(PENDING)
  method        String?
  checkoutUrl   String?
  failureReason String?
  fee           Float?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  invoice       Invoice         @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum PaymentProvider {
  MONEROO
  FEDAPAY
  MANUAL
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  type      NotificationType @default(INFO)
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@index([type])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  details   String?
  createdAt DateTime @default(now())
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  admin     User     @relation("AdminActions", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entity, entityId])
}

model Ticket {
  id           String           @id @default(cuid())
  title        String
  description  String
  status       TicketStatus     @default(OPEN)
  priority     TicketPriority   @default(MEDIUM)
  clientId     String
  assignedToId String?
  projectId    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignedTo   User?            @relation("AssignedTickets", fields: [assignedToId], references: [id])
  client       User             @relation("ClientTickets", fields: [clientId], references: [id])
  project      Project?         @relation(fields: [projectId], references: [id])
  responses    TicketResponse[]

  @@index([clientId])
  @@index([assignedToId])
  @@index([projectId])
  @@index([status])
}

model TicketResponse {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  message    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
  ticket     Ticket   @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([authorId])
}

model PortfolioProject {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String
  image       String
  tech        String[]
  url         String?
  github      String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  role       TeamRole @default(DEVELOPER)
  allocation Int      @default(100)
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Milestone {
  id            String          @id @default(cuid())
  projectId     String
  title         String
  description   String?
  dueDate       DateTime?
  status        MilestoneStatus @default(PLANNED)
  position      Int             @default(0)
  validatedAt   DateTime?
  validatedById String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks         Task[]
  deliverables  Deliverable[]

  @@index([projectId])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  milestoneId String?
  title       String
  description String?
  status      TaskStatus   @default(BACKLOG)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  dueDate     DateTime?
  estimateH   Float?
  position    Int          @default(0)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([milestoneId])
}

model Deliverable {
  id           String              @id @default(cuid())
  projectId    String
  milestoneId  String?
  name         String
  description  String?
  version      String              @default("v1.0")
  category     DeliverableCategory @default(OTHER)
  fileUrl      String?
  status       DeliverableStatus   @default(DRAFT)
  feedback     String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone    Milestone?          @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  files        DeliverableFile[]

  @@index([projectId, status])
  @@index([milestoneId])
}

model DeliverableFile {
  id            String      @id @default(cuid())
  deliverableId String
  name          String
  url           String
  mimeType      String      @default("application/octet-stream")
  size          Int         @default(0)
  createdAt     DateTime    @default(now())
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
}

model WebhookLog {
  id             String   @id @default(cuid())
  provider       String
  event          String?
  reference      String?
  signatureValid Boolean  @default(false)
  status         Int
  message        String?
  payload        String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([provider])
}

model StoredFile {
  id        String   @id @default(cuid())
  name      String
  mimeType  String
  size      Int
  data      Bytes
  projectId String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

enum TeamRole {
  LEAD
  DEVELOPER
  DESIGNER
  QA
  DEVOPS
  CONSULTANT
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  IN_REVIEW
  VALIDATED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DeliverableStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  ACCEPTED
}

enum DeliverableCategory {
  DESIGN
  DEVELOPMENT
  DOCUMENTATION
  CONTENT
  DEPLOYMENT
  OTHER
}

enum UserRole {
  ADMIN
  STAFF
  CLIENT
}

enum ProjectStatus {
  ONBOARDING
  ANALYSIS
  DESIGN
  DEV
  QA
  DEPLOYMENT
  DONE
}

enum ContractStatus {
  DRAFT
  SIGNED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum RequirementStatus {
  SUGGESTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RequirementCategory {
  FUNCTIONAL
  TECHNICAL
  DESIGN
  SECURITY
  PERFORMANCE
  OTHER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  PROJECT
  PAYMENT
  CHAT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
