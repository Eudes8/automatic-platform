generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  createdAt       DateTime         @default(now())
  role            UserRole         @default(CLIENT)
  avatarUrl       String?
  companyName     String?
  industry        String?
  phone           String?
  updatedAt       DateTime         @default(now()) @updatedAt
  adminActions    AuditLog[]       @relation("AdminActions")
  invoices        Invoice[]
  messages        Message[]
  notifications   Notification[]
  projects        Project[]
  assignedTickets Ticket[]         @relation("AssignedTickets")
  clientTickets   Ticket[]         @relation("ClientTickets")
  ticketResponses TicketResponse[]
  conversations   Conversation[]   @relation("ConversationUsers")

  @@index([email])
}

model Project {
  id             String         @id @default(cuid())
  title          String
  description    String?
  budget         Float?
  progress       Int            @default(0)
  clientId       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  contractSigned Boolean        @default(false)
  contractUrl    String?
  status         ProjectStatus  @default(ONBOARDING)
  category       String?
  techStack      String[]
  timeline       String?
  assets         Asset[]
  contracts      Contract[]
  conversations  Conversation[]
  invoices       Invoice[]
  messages       Message[]
  client         User           @relation(fields: [clientId], references: [id])
  requirements   Requirement[]
  tickets        Ticket[]

  @@index([clientId])
  @@index([status])
  @@index([category])
}

model Requirement {
  id            String                     @id @default(cuid())
  projectId     String
  title         String
  description   String
  status        RequirementStatus          @default(SUGGESTED)
  createdBy     String
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  category      RequirementCategory        @default(OTHER)
  project       Project                    @relation(fields: [projectId], references: [id])
  comments      RequirementComment[]
  statusHistory RequirementStatusHistory[]

  @@index([projectId])
}

model RequirementComment {
  id            String      @id @default(cuid())
  requirementId String
  authorId      String
  text          String
  createdAt     DateTime    @default(now())
  attachments   String[]
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  @@index([requirementId])
}

model RequirementStatusHistory {
  id            String             @id @default(cuid())
  requirementId String
  from          RequirementStatus?
  to            RequirementStatus
  changedBy     String
  createdAt     DateTime           @default(now())
  requirement   Requirement        @relation(fields: [requirementId], references: [id])

  @@index([requirementId])
}

model Contract {
  id              String         @id @default(cuid())
  projectId       String
  content         String
  signatureBase64 String?
  signedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  status          ContractStatus @default(DRAFT)
  project         Project        @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model Conversation {
  id        String    @id @default(cuid())
  subject   String?
  projectId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project?  @relation(fields: [projectId], references: [id])
  messages  Message[]
  users     User[]    @relation("ConversationUsers")

  @@index([projectId])
}

model Message {
  id             String        @id @default(cuid())
  projectId      String?
  senderId       String
  text           String
  attachment     String?
  createdAt      DateTime      @default(now())
  conversationId String?
  read           Boolean       @default(false)
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  project        Project?      @relation(fields: [projectId], references: [id])
  sender         User          @relation(fields: [senderId], references: [id])

  @@index([projectId])
  @@index([senderId])
  @@index([conversationId])
}

model Asset {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model Invoice {
  id          String        @id @default(cuid())
  projectId   String?
  clientId    String
  amount      Float
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime
  pdfUrl      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  description String?
  client      User          @relation(fields: [clientId], references: [id])
  project     Project?      @relation(fields: [projectId], references: [id])

  @@index([clientId])
  @@index([projectId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  type      NotificationType @default(INFO)
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@index([type])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  details   String?
  createdAt DateTime @default(now())
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  admin     User     @relation("AdminActions", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entity, entityId])
}

model Ticket {
  id           String           @id @default(cuid())
  title        String
  description  String
  status       TicketStatus     @default(OPEN)
  priority     TicketPriority   @default(MEDIUM)
  clientId     String
  assignedToId String?
  projectId    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignedTo   User?            @relation("AssignedTickets", fields: [assignedToId], references: [id])
  client       User             @relation("ClientTickets", fields: [clientId], references: [id])
  project      Project?         @relation(fields: [projectId], references: [id])
  responses    TicketResponse[]

  @@index([clientId])
  @@index([assignedToId])
  @@index([projectId])
  @@index([status])
}

model TicketResponse {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  message    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
  ticket     Ticket   @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([authorId])
}

model PortfolioProject {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String
  image       String
  tech        String[]
  url         String?
  github      String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum UserRole {
  ADMIN
  STAFF
  CLIENT
}

enum ProjectStatus {
  ONBOARDING
  ANALYSIS
  DESIGN
  DEV
  QA
  DEPLOYMENT
  DONE
}

enum ContractStatus {
  DRAFT
  SIGNED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum RequirementStatus {
  SUGGESTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RequirementCategory {
  FUNCTIONAL
  TECHNICAL
  DESIGN
  SECURITY
  PERFORMANCE
  OTHER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  PROJECT
  PAYMENT
  CHAT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
