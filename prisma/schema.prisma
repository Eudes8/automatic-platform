
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  CLIENT
}

enum ProjectStatus {
  ONBOARDING
  ANALYSIS
  DESIGN
  DEV
  QA
  DEPLOYMENT
  DONE
}

enum ContractStatus {
  DRAFT
  SIGNED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      UserRole  @default(CLIENT)
  projects  Project[]
  messages  Message[]
  invoices  Invoice[]
  notifications Notification[]
  adminActions AuditLog[] @relation("AdminActions")
  createdAt DateTime  @default(now())

  @@index([email])
}

model Project {
  id              String        @id @default(cuid())
  title           String
  description     String?
  budget          Float?
  status          ProjectStatus @default(ONBOARDING)
  progress        Int           @default(0)
  contractUrl     String?
  contractSigned  Boolean       @default(false)
  clientId        String
  client          User          @relation(fields: [clientId], references: [id])
  contracts       Contract[]
  messages        Message[]
  assets          Asset[]
  invoices        Invoice[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
}

model Contract {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id])
  content         String         @db.Text
  signatureBase64 String?        @db.Text
  signedAt        DateTime?
  status          ContractStatus @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([projectId])
}

model Message {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  text       String   @db.Text
  attachment String?
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([senderId])
}

model Asset {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Invoice {
  id        String        @id @default(cuid())
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id])
  clientId  String
  client    User          @relation(fields: [clientId], references: [id])
  amount    Float
  status    InvoiceStatus @default(DRAFT)
  dueDate   DateTime
  pdfUrl    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId])
  @@index([projectId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation("AdminActions", fields: [adminId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([adminId])
}

model PortfolioProject {
  id          String   @id @default(cuid())
  title       String
  category    String
  image       String
  description String   @db.Text
  tech        String[]
  githubUrl   String?
  liveUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}