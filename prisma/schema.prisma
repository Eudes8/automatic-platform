
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  CLIENT
}

enum ProjectStatus {
  ONBOARDING
  ANALYSIS
  DESIGN
  DEV
  QA
  DEPLOYMENT
  DONE
}

enum ContractStatus {
  DRAFT
  SIGNED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  role            UserRole  @default(CLIENT)
  phone           String?
  companyName     String?
  industry        String?
  avatarUrl       String?
  projects        Project[]
  messages        Message[]
  conversations   Conversation[] @relation("ConversationUsers")
  invoices        Invoice[]
  notifications   Notification[]
  adminActions    AuditLog[] @relation("AdminActions")
  clientTickets   Ticket[] @relation("ClientTickets")
  assignedTickets Ticket[] @relation("AssignedTickets")
  ticketResponses TicketResponse[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([email])
}

model Project {
  id              String        @id @default(cuid())
  title           String
  description     String?
  category        String?       // Web App, Mobile, SaaS, AI, etc.
  techStack       String[]      // Ex: ["Next.js", "Tailwind", "Supabase"]
  timeline        String?       // Standard, Fast-Track, Emergency
  budget          Float?
  status          ProjectStatus @default(ONBOARDING)
  progress        Int           @default(0)
  contractUrl     String?
  contractSigned  Boolean       @default(false)
  clientId        String
  client          User          @relation(fields: [clientId], references: [id])
  contracts       Contract[]
  messages        Message[]
  assets          Asset[]
  invoices        Invoice[]
  tickets         Ticket[]
  requirements    Requirement[] // Nouveau: Cahier des charges collaboratif
  conversations   Conversation[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([category])
}

enum RequirementStatus {
  SUGGESTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RequirementCategory {
  FUNCTIONAL
  TECHNICAL
  DESIGN
  SECURITY
  PERFORMANCE
  OTHER
}

model Requirement {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id])
  title       String
  description String            @db.Text
  status      RequirementStatus @default(SUGGESTED)
  category    RequirementCategory @default(OTHER)
  statusHistory RequirementStatusHistory[]
  createdBy   String            // ID de l'utilisateur qui a proposé
  comments    RequirementComment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([projectId])
}

model RequirementComment {
  id             String      @id @default(cuid())
  requirementId  String
  requirement    Requirement @relation(fields: [requirementId], references: [id])
  authorId       String
  text           String      @db.Text
  attachments    String[]
  createdAt      DateTime    @default(now())

  @@index([requirementId])
}

model RequirementStatusHistory {
  id            String            @id @default(cuid())
  requirementId String
  requirement   Requirement       @relation(fields: [requirementId], references: [id])
  from          RequirementStatus?
  to            RequirementStatus
  changedBy     String
  createdAt     DateTime          @default(now())
  
  @@index([requirementId])
}

model Contract {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id])
  content         String         @db.Text
  signatureBase64 String?        @db.Text
  signedAt        DateTime?
  status          ContractStatus @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([projectId])
}

model Conversation {
  id        String    @id @default(cuid())
  subject   String?
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])
  users     User[]    @relation("ConversationUsers")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id])
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id])
  text           String        @db.Text
  attachment     String?
  read           Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([projectId])
  @@index([senderId])
  @@index([conversationId])
}

model Asset {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Invoice {
  id          String        @id @default(cuid())
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  clientId    String
  client      User          @relation(fields: [clientId], references: [id])
  amount      Float
  description String?       @db.Text
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime
  pdfUrl      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@index([projectId])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  PROJECT
  PAYMENT
  CHAT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@index([type])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation("AdminActions", fields: [adminId], references: [id])
  action    String
  entity    String?  // Quelle entité a été touchée (Project, User, etc.)
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([entity, entityId])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  clientId    String
  client      User           @relation("ClientTickets", fields: [clientId], references: [id])
  assignedToId String?
  assignedTo  User?          @relation("AssignedTickets", fields: [assignedToId], references: [id])
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id])
  responses   TicketResponse[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([clientId])
  @@index([assignedToId])
  @@index([projectId])
  @@index([status])
}

model TicketResponse {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  message   String   @db.Text
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
}

model PortfolioProject {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String   @db.Text
  image       String
  tech        String[]
  url         String?
  github      String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}